# INSURID Sprint 2 — 必要な環境変数
# このファイルを .env.local にコピーして値を設定してください

# ── Supabase ──────────────────────────────────────────────────
# Supabase Project Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...   # Admin UI / API routes 用（公開しないこと）

# ── Anthropic ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Admin Auth ────────────────────────────────────────────────
# /admin/insurid のログインパスワード（任意の文字列でOK）
ADMIN_PASSWORD=your-secure-password-here

# ── App Base URL ──────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Google Analytics 4 ────────────────────────────────────────
# Google Analytics > 管理 > データストリーム > ウェブ から取得
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
